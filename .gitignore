### LOCAL FILES ###
ml/literature/
ml/references/

### DATA SAFETY (ML) ###
# 1. Ignore everything inside ml/data/ and its subdirectories
/ml/data/

# 2. Re-include directory structures (allows Git to walk into them)
!ml/data/raw/
!ml/data/interim/
!ml/data/processed/
!ml/data/mock_data/

# 3. Allow only .gitkeep files to be tracked in real data folders
!ml/data/raw/.gitkeep
!ml/data/interim/.gitkeep
!ml/data/processed/.gitkeep

# 4. Allow all mock/synthetic dataset files
!ml/data/mock_data/**

### GENERATED REPORT OUTPUTS ###
ml/reports/figures/*
!ml/reports/figures/.gitkeep

ml/reports/tables/*
!ml/reports/tables/.gitkeep

### TRAINED MODELS ###
ml/models/*
!ml/models/.gitkeep

### SERVER MODEL ARTIFACTS ###
apps/server/artifacts/*
!apps/server/artifacts/.gitkeep

